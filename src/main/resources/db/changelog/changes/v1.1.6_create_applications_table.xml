<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v1.1.6-create-applications" author="alex">
        <createTable tableName="applications">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- 关联房源 -->
            <column name="property_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- 申请租客 Email -->
            <column name="user_email" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <!-- 期望租期（月），澳洲通常是 6 或 12 个月 -->
            <column name="lease_term_months" type="INT" defaultValue="12">
                <constraints nullable="false"/>
            </column>
            <!-- 拟搬入日期 -->
            <column name="move_in_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <!-- 申请状态：SUBMITTED, APPROVED, REJECTED -->
            <column name="status" type="VARCHAR(30)" defaultValue="SUBMITTED">
                <constraints nullable="false"/>
            </column>
            <!-- 审计日志 -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_applications_user" tableName="applications">
            <column name="user_email"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>